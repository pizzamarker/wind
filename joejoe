## Quick Start

```lua
local WindUI = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/jonathabejose-alt/Wind-UI-Boreal/refs/heads/main/WindUI%20Boreal"
))()

WindUI:SetNotificationLower(true)

local Window = WindUI:CreateWindow({
    Title = "Shiny Hub",
    Author = "by developer",
    Folder = "ShinyHub",
    Icon = "sparkles",
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.LeftShift,
    Transparent = true,
    Resizable = true,
    ModernLayout = true,
    BottomDragBarEnabled = true,
    Watermark = {
        Enabled = true,
        Text = "Shiny Hub | v1.0.0",
        Position = "bottom-right",
        Opacity = 0.45,
    },
})

local MainTab = Window:Tab({
    Title = "Main",
    Icon = "house",
    Border = true,
})

MainTab:Button({
    Title = "Notify",
    Desc = "Shows a notification",
    Icon = "bell",
    Callback = function()
        WindUI:Notify({
            Title = "Hello",
            Content = "WindUI Shiny is loaded.",
            Icon = "check-circle",
            Duration = 3,
        })
    end,
})

MainTab:ToggleKeybind({
    Title = "Feature",
    Desc = "Toggle with keybind",
    Value = false,
    Keybind = "G",
    Flag = "feature_toggle_keybind",
    Callback = function(state)
        print("Feature:", state)
    end,
})

MainTab:Select()
```

