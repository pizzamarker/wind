Stepper:Add(5, true)
Stepper:Increment(5, true)
Stepper:Decrement(5, true)
Stepper:SetRange(0, 200, false)
Stepper:SetStep(10)
Stepper:SetPrecision(1)
Stepper:SetPrefix("$")
Stepper:SetSuffix(" pts")
Stepper:SetFormat(function(value, min, max, self)
